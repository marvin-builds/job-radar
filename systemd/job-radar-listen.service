[Unit]
Description=job-radar: handle Telegram buttons (deep reports, skip, applied)
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=@REPO@
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m job_radar listen
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
