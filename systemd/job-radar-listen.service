[Unit]
Description=job-radar: Telegram bot for all instances (interview, buttons, deep reports)
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=@REPO@
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m job_radar listen
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
