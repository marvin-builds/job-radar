[Unit]
Description=job-radar: scheduled job portal polls

[Timer]
# Hourly on weekdays, every two hours on weekends.
OnCalendar=Mon..Fri *-*-* 07..21:00
OnCalendar=Sat,Sun *-*-* 09..19/2:00
RandomizedDelaySec=5min
# Catch up on a missed run after suspend or shutdown.
Persistent=true

[Install]
WantedBy=timers.target
