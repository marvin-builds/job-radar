[Unit]
Description=job-radar: scheduled job portal polls for %i

[Timer]
# Every hour 07-22; each poll checks the person's own times (/zeiten, job_radar/schedule.py)
# and ends right away outside them.
OnCalendar=*-*-* 07..22:00
# Spread the instances out so they rarely wait for the Claude lock.
RandomizedDelaySec=10min
# Catch up on a missed run after suspend or shutdown.
Persistent=true

[Install]
WantedBy=timers.target
